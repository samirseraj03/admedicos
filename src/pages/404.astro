---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Página no encontrada | Diseñando Sonrisas" description="La página solicitada no está disponible." robots="noindex, nofollow">
	<main class="grid min-h-screen place-items-center bg-[#171816] px-6 py-16 text-white">
		<div class="max-w-xl text-center">
			<p class="text-sm font-medium uppercase tracking-[0.16em] text-[#d49a70]">Error 404</p>
			<h1 class="mt-5 text-5xl font-medium tracking-[-0.04em] text-balance md:text-7xl">Esta página no está aquí</h1>
			<p class="mt-6 text-lg leading-8 text-pretty text-white/60">Puedes volver al recorrido de la clínica o llamar si necesitas pedir una primera visita.</p>
			<a href="/" class="mt-10 inline-flex rounded-full bg-[#b36f3f] px-6 py-3 font-semibold text-[#171816] transition-colors hover:bg-[#c8804c]">Volver al inicio</a>
		</div>
	</main>
</Layout>
