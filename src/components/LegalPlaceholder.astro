---
import Layout from '../layouts/Layout.astro';
interface Props { title: string; }
const { title } = Astro.props;
---

<Layout title={`${title} | Diseñando Sonrisas`} description={`${title} de la Clínica Dental Diseñando Sonrisas.`} robots="noindex, nofollow">
	<main class="min-h-screen bg-[#f5f1e8] px-6 py-16 md:px-10 md:py-24">
		<div class="mx-auto max-w-3xl">
			<a href="/" class="inline-flex rounded-full border border-black/15 px-4 py-2 text-sm font-medium transition-colors hover:bg-[#171816] hover:text-white">← Volver a la página principal</a>
			<p class="mt-20 text-sm font-medium uppercase tracking-[0.16em] text-[#8d512b]">Documento legal</p>
			<h1 class="mt-5 text-4xl font-medium tracking-[-0.03em] text-balance md:text-6xl">{title}</h1>
			<div class="mt-10 border border-black/10 bg-[#fffdf8] p-6 md:p-10">
				<p class="text-lg leading-8 text-pretty text-black/65">Contenido pendiente de revisión y validación legal por parte de la clínica. Esta página no se publicará para indexación hasta disponer del texto definitivo.</p>
			</div>
		</div>
	</main>
</Layout>
